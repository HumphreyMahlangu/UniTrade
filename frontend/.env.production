# Used by "npm run build" (so also by Vercel): the address of the deployed API.
# Kept in git on purpose: it is not a secret, and changing it is a normal commit (push = redeploy),
# so nobody needs access to the Vercel dashboard. A VITE_API_URL set in Vercel would override this.
VITE_API_URL=https://unitrade-cput-api.onrender.com
